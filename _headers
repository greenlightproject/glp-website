# Fonts never change (the file names come versioned from the font service).
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images and icons: browsers keep them for a week. To replace an image right away, give it a new file name.
/assets/images/*
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800

# Page frames used by netlify/edge-functions/blog.js; never index them on their own.
/_templates/*
  X-Robots-Tag: noindex
